        <zone h='35889' id='3' name='Monthly Sales Trend — 2012 vs 2013' w='95688' x='938' y='11889' />
        <zone h='7111' id='8' name='Monthly Sales Trend — 2012 vs 2013' pane-specification-id='0' param='[federated.0o9kf581dj8b8j10vxxcm0amtwmt].[yr:Date:ok]' show-title='false' type-v2='color' w='8750' x='85438' y='14778' />
        <zone h='36333' id='9' name='Month-by-Month: 2012 vs 2013 Sales ($)' w='33313' x='3125' y='50667' />
        <zone h='32556' id='10' name='YoY Sales Growth (%)' w='53250' x='44313' y='54889' />
        <zone h='10333' id='14' type-v2='text' w='95375' x='2500' y='88556'>
          <formatted-text>
            <run bold='true' fontcolor='#0d2550' fontname='-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif' fontsize='11'>Key finding:</run>
            <run fontcolor='#1a3a6b' fontname='-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif' fontsize='11'> Sales grew consistently from 2012 to 2013. 2013 monthly average ($34,720) was </run>
            <run bold='true' fontcolor='#0d2550' fontname='-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif' fontsize='11'>5.6% higher</run>
            <run fontcolor='#1a3a6b' fontname='-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif' fontsize='11'> than 2012 ($33,097). The peak months are </run>
            <run bold='true' fontcolor='#0d2550' fontname='-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif' fontsize='11'>June–August</run>
            <run fontcolor='#1a3a6b' fontname='-apple-system,BlinkMacSystemFont,Segoe UI,sans-serif' fontsize='11'> (summer season). November is the weakest month in both years. Total 2013 sales of $416,641 beat 2012 ($403,170) by $13,471.</run>
          </formatted-text>
        </zone>
        <zone forceUpdate='true' h='7111' id='15' type-v2='text' w='99063' x='1125' y='2000'>
          <formatted-text>
            <run bold='true' fontcolor='#ffffff' fontname='Calibri' fontsize='22'>Overall Trend</run>
          </formatted-text>
          <zone-style>
            <format attr='border-color' value='#000000' />
