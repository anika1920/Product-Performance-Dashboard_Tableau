    <worksheet name='Month-by-Month: 2012 vs 2013 Sales ($)'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontname='Calibri' fontsize='12'>&lt;Sheet Name&gt;</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Fact (SingDM)' name='federated.0o9kf581dj8b8j10vxxcm0amtwmt' />
          </datasources>
          <datasource-dependencies datasource='federated.0o9kf581dj8b8j10vxxcm0amtwmt'>
            <column caption='YOY Growth' datatype='real' name='[Calculation_0144346441252867]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -12)) / ABS(LOOKUP(SUM([Sales]), -12))'>
                <table-calc ordering-type='Rows' />
              </calculation>
            </column>
            <column caption='2012 Sales' datatype='integer' name='[Calculation_0144346442387460]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Date]) = 2012 THEN [Sales] END)' />
            </column>
            <column caption='2013 Sales' datatype='integer' name='[Calculation_0144346442461189]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF YEAR([Date]) = 2013 THEN [Sales] END)' />
            </column>
            <column caption='YoY %' datatype='real' name='[Calculation_0144346442612742]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='(&#13;&#10;    SUM(IF YEAR([Date]) = 2013 THEN [Sales] END)&#13;&#10;    -&#13;&#10;    SUM(IF YEAR([Date]) = 2012 THEN [Sales] END)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(IF YEAR([Date]) = 2012 THEN [Sales] END)' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Sales]' role='measure' type='quantitative' />
            <column-instance column='[Date]' derivation='Month' name='[mn:Date:ok]' pivot='key' type='ordinal' />
            <column-instance column='[Calculation_0144346441252867]' derivation='User' name='[usr:Calculation_0144346441252867:qk:3]' pivot='key' type='quantitative'>
              <table-calc ordering-type='Columns' />
            </column-instance>
            <column-instance column='[Calculation_0144346442387460]' derivation='User' name='[usr:Calculation_0144346442387460:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0144346442461189]' derivation='User' name='[usr:Calculation_0144346442461189:qk]' pivot='key' type='quantitative' />
            <column-instance column='[Calculation_0144346442612742]' derivation='User' name='[usr:Calculation_0144346442612742:qk]' pivot='key' type='quantitative' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0o9kf581dj8b8j10vxxcm0amtwmt].[:Measure Names]'>
            <groupfilter function='union' user:op='manual'>
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0o9kf581dj8b8j10vxxcm0amtwmt].[usr:Calculation_0144346442387460:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0o9kf581dj8b8j10vxxcm0amtwmt].[usr:Calculation_0144346442461189:qk]&quot;' />
              <groupfilter function='member' level='[:Measure Names]' member='&quot;[federated.0o9kf581dj8b8j10vxxcm0amtwmt].[usr:Calculation_0144346442612742:qk]&quot;' />
            </groupfilter>
          </filter>
          <manual-sort column='[federated.0o9kf581dj8b8j10vxxcm0amtwmt].[:Measure Names]' direction='ASC'>
            <dictionary>
              <bucket>&quot;[federated.0o9kf581dj8b8j10vxxcm0amtwmt].[usr:Calculation_0144346442387460:qk]&quot;</bucket>
              <bucket>&quot;[federated.0o9kf581dj8b8j10vxxcm0amtwmt].[usr:Calculation_0144346442461189:qk]&quot;</bucket>
