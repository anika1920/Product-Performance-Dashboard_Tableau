      <aliases enabled='yes' />
      <column aggregation='Sum' datatype='integer' default-format='*000' name='[Area Code]' role='dimension' semantic-role='[AreaCode].[Name]' type='ordinal' />
      <column datatype='integer' name='[Budget COGS]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Budget Margin]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Budget Profit]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Budget Sales]' role='measure' type='quantitative' />
      <column caption='Cogs' datatype='integer' name='[COGS]' role='measure' type='quantitative' />
      <column caption='Profit Variance' datatype='integer' name='[Calculation_0144346435112960]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) - SUM([Budget Profit])' />
      </column>
      <column caption='profit variance color' datatype='string' name='[Calculation_0144346435366913]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0144346435112960] &gt;= 0 THEN &quot;Above&quot; ELSE &quot;Below&quot; END' />
      </column>
      <column caption='Sales Variance' datatype='integer' name='[Calculation_0144346437783554]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales]) - SUM([Budget Sales])' />
      </column>
      <column caption='YOY Growth' datatype='real' name='[Calculation_0144346441252867]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Sales]) - LOOKUP(SUM([Sales]), -12)) / ABS(LOOKUP(SUM([Sales]), -12))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='2012 Sales' datatype='integer' name='[Calculation_0144346442387460]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([Date]) = 2012 THEN [Sales] END)' />
      </column>
      <column caption='2013 Sales' datatype='integer' name='[Calculation_0144346442461189]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF YEAR([Date]) = 2013 THEN [Sales] END)' />
      </column>
      <column caption='YoY %' datatype='real' name='[Calculation_0144346442612742]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(&#13;&#10;    SUM(IF YEAR([Date]) = 2013 THEN [Sales] END)&#13;&#10;    -&#13;&#10;    SUM(IF YEAR([Date]) = 2012 THEN [Sales] END)&#13;&#10;)&#13;&#10;/&#13;&#10;SUM(IF YEAR([Date]) = 2012 THEN [Sales] END)' />
      </column>
      <column caption='Change' datatype='string' name='[Calculation_0144346453176328]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0144346442612742] &gt;= 0 THEN&#13;&#10;    &quot;▲ &quot; + STR(ROUND([Calculation_0144346442612742] * 100, 1)) + &quot;%&quot;&#13;&#10;ELSE&#13;&#10;    &quot;▼ &quot; + STR(ROUND(ABS([Calculation_0144346442612742]) * 100, 1)) + &quot;%&quot;&#13;&#10;END' />
      </column>
      <column caption='yoy color' datatype='string' name='[Calculation_0144346455052297]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0144346442612742] &gt;= 0 THEN &quot;Positive&quot;&#13;&#10;ELSE &quot;Negative&quot;&#13;&#10;END' />
      </column>
      <column caption='Profit Margin' datatype='real' name='[Calculation_0144346469359626]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Profit]) / SUM([Sales])' />
      </column>
      <column caption='Top Product' datatype='string' name='[Calculation_0144346471272460]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF { FIXED [Product] : SUM([Profit]) } = { MAX({ FIXED [Product] : SUM([Profit]) }) }&#13;&#10;    THEN [Product]&#13;&#10;    ELSE &quot;&quot;&#13;&#10;    END&#13;&#10;)}' />
      </column>
      <column caption='Under Performer' datatype='string' name='[Calculation_0144346474110990]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='{ FIXED : MAX(&#13;&#10;    IF { FIXED [Product] : SUM([Profit]) } = { MIN({ FIXED [Product] : SUM([Profit]) }) }&#13;&#10;    THEN [Product]&#13;&#10;    ELSE &quot;&quot;&#13;&#10;    END&#13;&#10;)}' />
      </column>
      <column caption='Region Sales' datatype='integer' name='[Calculation_0144346475315215]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Market] : SUM([Sales]) }' />
      </column>
      <column caption='Region Profit' datatype='integer' name='[Calculation_0144346475515920]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Market] : SUM([Profit]) }' />
      </column>
      <column caption='State Profit' datatype='integer' name='[Calculation_0144346475622417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [State] : SUM([Profit]) }' />
      </column>
      <column caption='Top Sales Region' datatype='string' name='[Calculation_0144346475708434]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0144346475315215] = { MAX([Calculation_0144346475315215]) }&#13;&#10;THEN [Market]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Top Profit Region' datatype='string' name='[Calculation_0144346475794451]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0144346475515920] = { MAX([Calculation_0144346475515920]) }&#13;&#10;THEN [Market]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Weakest Region' datatype='string' name='[Calculation_0144346487824404]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_0144346475515920] = { MIN([Calculation_0144346475515920]) }&#13;&#10;THEN [Market]&#13;&#10;ELSE &quot;&quot;&#13;&#10;END' />
      </column>
      <column caption='Top Performing State' datatype='string' name='[Calculation_0144346488479765]' role='dimension' type='nominal'>
